# EXAMPLE ONLY. make setup generates private .env.local/.env.dev without overwriting.
# Those Compose input files accept ONLY these two keys (safe placeholder below):
POSTGRES_PASSWORD=replace_with_random_url_safe_password
APP_PORT=5100

# Direct app deployments: configure these explicitly in the process environment.
# Do not copy these extra keys into the two Compose input files.
# APP_ENV=local
# DATABASE_URL=postgresql+psycopg://service:replace_me@127.0.0.1:5432/goalstats_template_py_local
# LOG_LEVEL=INFO
# OPENAPI_ENABLED=true
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_KEY_PREFIX=goalstats-template-py:local:v1
# CACHE_TTL_SECONDS=300
# The app does not implicitly read dotenv files. Redis is optional for correctness.
