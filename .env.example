# EXAMPLE ONLY. make setup generates private .env.local/.env.dev without overwriting.
# Required Compose inputs (safe placeholder below):
POSTGRES_PASSWORD=replace_with_random_url_safe_password
APP_PORT=5100
# Optional LOCAL host ports (defaults shown; all app/provider ports must differ):
# HOST_APP_PORT=5300
# LOCAL_POSTGRES_PORT=55432
# LOCAL_REDIS_PORT=56379

# Direct app deployments: configure these explicitly in the process environment.
# Do not copy the app keys below into the Compose input files.
# make providers ENV=local generates private .env.host.local for explicit IDE loading.
# APP_ENV=local
# DATABASE_URL=postgresql+psycopg://goalstats:replace_me@127.0.0.1:55432/goalstats_template_py_local
# LOG_LEVEL=INFO
# OPENAPI_ENABLED=true
# REDIS_URL=redis://127.0.0.1:56379/0
# CACHE_KEY_PREFIX=goalstats-template-py:local:v1
# CACHE_TTL_SECONDS=300
# FLASK_DEBUG=0
# The app does not implicitly read dotenv files. Redis is optional for correctness.
