{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: host LOCAL",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "subProcess": false,
      "justMyCode": true
    },
    {
      "name": "pytest: owned TEST session",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "args": [
        "${input:testNode}",
        "-s"
      ],
      "console": "integratedTerminal",
      "subProcess": false,
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "testNode",
      "type": "promptString",
      "description": "Integration test file or pytest node",
      "default": "tests/integration/infra/repositories/test_persistence.py"
    }
  ]
}
